<Project>
  <PropertyGroup>
    <BuildNumber Condition="'$(BuildNumber)' == ''">0.0</BuildNumber>
    <MajorVersion>9.60</MajorVersion>
    <Version>$(MajorVersion).$(BuildNumber)</Version>
  </PropertyGroup>

  <PropertyGroup>
    <!-- Workaround for breaking changes in PackageDefinitions metadata. https://github.com/dotnet/sdk/issues/30809 -->
    <!-- TODO: avoid of the PackageDefinitions usage. -->
    <EmitLegacyAssetsFileItems>true</EmitLegacyAssetsFileItems>
  </PropertyGroup>

  <PropertyGroup>
    <Publisher Condition="'$(Publisher)' == ''">CN=Contoso Ltd.</Publisher>
    <PublisherDisplayName Condition="'$(PublisherDisplayName)' == ''">Contoso Ltd.</PublisherDisplayName>
  </PropertyGroup>

  <PropertyGroup>
    <CommerceSdkPackagesVersion>[9.60.*-*,9.61)</CommerceSdkPackagesVersion>
    <CommercePosPackagesVersion>[9.60.*-*,9.61)</CommercePosPackagesVersion>
    <CommerceChannelPackagesVersion>[9.60.*-*,9.61)</CommerceChannelPackagesVersion>
    <CommerceHwsPackagesVersion>[9.60.*-*,9.61)</CommerceHwsPackagesVersion>
    <CommerceToolsPackagesVersion>[10.60.*,10.61)</CommerceToolsPackagesVersion>
    <CommercePaymentsPackagesVersion>[10.60.*-*,10.61)</CommercePaymentsPackagesVersion>
    <CommerceFrameworkPackagesVersion>[10.*-*,11)</CommerceFrameworkPackagesVersion>
    <!-- Newtonsoft.Json -->
    <NewtonsoftJsonVersion>13.0.3</NewtonsoftJsonVersion>
    <MSTestAdapterVersion>3.6.1</MSTestAdapterVersion>
    <MSTestFrameworkVersion>3.6.1</MSTestFrameworkVersion>
    <MicrosoftNetTestSdkVersion>17.11.1</MicrosoftNetTestSdkVersion>
  </PropertyGroup>
</Project>